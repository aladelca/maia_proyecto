MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_DISABLE_AGENT_HINT=1
MLFLOW_DISABLE_TELEMETRY=true

# Despliegue y entrenamiento en la nube (opcional). Copiar los valores de la sesión de AWS
# Academy; vencen al detenerla. Cargar con: set -a; source .env; set +a
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-west-2
# VERCEL_API_TOKEN=
# TF_VAR_project_name=
# TF_VAR_team_id=
# Opcional para run-training.sh: tamaño de la instancia y UUID de una campaña a reanudar.
# TRAIN_INSTANCE_TYPE=t3.large
# CAMPAIGN_ID=
